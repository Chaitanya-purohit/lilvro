# Local Supabase (from `npx supabase status` after `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# WebSocket bridge URL for the child blob page (defaults to ws://<hostname>:8765)
# Set this when deploying remotely, e.g. if using ngrok to expose the Python agent:
# NEXT_PUBLIC_WS_URL=ws://abc123.ngrok.io
